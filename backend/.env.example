# Copy to .env and fill in for a real deployment (local dev runs fine with
# none of this set — see app/auth.py / app/db.py / app/logic.py for the
# fallback behaviour of each).

ENVIRONMENT=production
# Signs login tokens (app/auth.py). Required when ENVIRONMENT=production —
# the app refuses to start without it. Generate with: openssl rand -hex 32
SECRET_KEY=

# Comma-separated frontend origins allowed to call this API. Defaults to the
# two local dev ports if unset — set this to your real deployed URLs.
CORS_ORIGINS=https://your-officer-dashboard.example,https://your-farmer-app.example

# Postgres in production (Supabase/Neon free tier — see README §15).
# Defaults to local SQLite if unset.
DATABASE_URL=postgresql://user:password@host:5432/vaari

# Shared code new officers need to self-register (app/main.py). Leave unset
# to keep self-serve officer signup closed — seed officers directly instead.
OFFICER_SIGNUP_CODE=

# Optional — real email sending (app/logic.py). Logs-and-reports-success
# instead if unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional — real WhatsApp Cloud API send (app/logic.py). Mocked if unset.
WHATSAPP_TOKEN=
